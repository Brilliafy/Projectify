# Root Environment Example for Projectify Microservices

# Common
JWT_SECRET=dev_secret_change_in_production
NODE_ENV=development

# User Service
USER_SERVICE_PORT=3001
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=userdb
DATABASE_URL=postgresql://admin:password123@postgres:5432/userdb

# Team Service
TEAM_SERVICE_PORT=3002
TEAM_MONGO_URI=mongodb://mongo:27017/teamdb

# Task Service
TASK_SERVICE_PORT=3003
TASK_MONGO_URI=mongodb://mongo:27017/taskdb
GCS_BUCKET_NAME=projectify-attachments-storage
GCP_PROJECT_ID=projectify-483418
# STORAGE_DRIVER can be 'local' (offline / dev fallback) or 'gcs'
STORAGE_DRIVER=local

# Notification Service
NOTIFICATION_SERVICE_PORT=3004
NOTIFICATION_MONGO_URI=mongodb://mongo:27017/notificationdb

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
